# Kirana environment (PRD §12.1). Copy to .env — never commit .env.
PORT=8080
DATA_DIR=./data
DATABASE_URL=./data/kirana.db
APP_ORIGIN=http://localhost:8080
# Required: cookie signing secret (openssl rand -hex 32)
SESSION_SECRET=change-me
LOG_LEVEL=info
TZ=UTC
BACKUP_KEEP_DAILY=14
# P6 only — must stay false until the user opts in (§13)
FEATURE_LLM=false
LLM_BASE_URL=
LLM_MODEL=
