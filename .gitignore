# dependencies / build output
node_modules/
dist/
out/
*.tsbuildinfo

# stray compiled artifacts must never shadow *.ts sources
shared/src/**/*.js
shared/src/**/*.js.map

# data — never commit user data or databases
data/
*.db
*.db-wal
*.db-shm
*.backup
*.backup.gz

# env & secrets
.env
.env.local

# test artifacts
coverage/
test-results/
playwright-report/
.blob-report/
playwright/.cache/
e2e/.tmp/

# tooling noise
.DS_Store
*.log
